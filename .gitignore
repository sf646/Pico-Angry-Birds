# ---------------------------------------------------------------
# Raspberry Pi Pico 2 (RP2350) / Pico SDK project
# ---------------------------------------------------------------

# CMake build output (regenerated by configure/build)
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
compile_commands.json
_deps/

# Pico build artifacts (in case any end up outside build/)
*.uf2
*.elf
*.bin
*.hex
*.dis
*.map
*.elf.map
*.pio.h

# Object files / libraries
*.o
*.obj
*.a
*.lib
*.d
*.su

# Local SDK checkouts (use PICO_SDK_PATH or the VS Code Pico extension instead)
pico-sdk/
pico-extras/
picotool/

# VS Code: keep the Pico extension config (settings, tasks, launch,
# c_cpp_properties, cmake-kits, extensions) but ignore local-only state
.vscode/*.log
.vscode/ipch/
.vscode/.browse.*
.history/

# Debugging (OpenOCD / GDB)
*.gdb_history
.gdb_history

# Editors / OS junk
*.swp
*~
.idea/
.DS_Store
Thumbs.db
desktop.ini
